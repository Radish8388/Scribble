<Window x:Class="Scribble.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Scribble"
        mc:Ignorable="d"
        PreviewKeyDown="Window_PreviewKeyDown"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        Title="Scribble"
        Height="450" Width="800">

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New Tab" InputGestureText="Ctrl+N" Click="New_Click">
                </MenuItem>
                <MenuItem Header="_Open" InputGestureText="Ctrl+O" Click="Open_Click">
                </MenuItem>
                <MenuItem Header="_Close Tab" Click="Close_Click">
                </MenuItem>
                <MenuItem x:Name="SaveMenu" Header="_Save" InputGestureText="Ctrl+S" Click="Save_Click">
                </MenuItem>
                <MenuItem Header="Save _As" Click="SaveAs_Click">
                </MenuItem>
                <MenuItem Header="Export to PNG" Click="Export_Click">
                </MenuItem>
                <Separator/>
                <MenuItem Header="_Print" InputGestureText="Ctrl+P" Click="Print_Click">
                </MenuItem>
                <Separator/>
                <MenuItem x:Name="RecentFilesMenuItem" Header="Recent Files">
                </MenuItem>
                <Separator/>
                <MenuItem Header="E_xit" InputGestureText="Alt+F4" Click="Exit_Click">
                </MenuItem>
            </MenuItem>

            <MenuItem Header="_Edit">
                <MenuItem x:Name="UndoMenu" Header="_Undo" InputGestureText="Ctrl+Z" Click="Undo_Click">
                </MenuItem>
                <MenuItem x:Name="RedoMenu" Header="_Redo" InputGestureText="Ctrl+Y" Click="Redo_Click">
                </MenuItem>
                <Separator/>
                <MenuItem Header="_Copy" InputGestureText="Ctrl+C" Click="Copy_Click">
                </MenuItem>
                <MenuItem Header="Clear _All" Click="ClearAll_Click">
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Pen">
                <MenuItem Header="_Width" Click="PenWidth_Click">
                </MenuItem>
                <MenuItem Header="_Color" Click="PenColor_Click">
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About Scribble" Click="About_Click">
                </MenuItem>
            </MenuItem>
        </Menu>

        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button Click="New_Click" ToolTip="New Tab">
                    <Image Source="Icons/new3.png" Height="20" Width="20"/>
                </Button>
                <Button Click="Open_Click" ToolTip="Open">
                    <Image Source="Icons/open3.png" Height="20" Width="20"/>
                </Button>
                <Button x:Name="SaveButton" Click="Save_Click" ToolTip="Save">
                    <Image Source="Icons/save3.png" Height="20" Width="20">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=Button}}" Value="False">
                                        <Setter Property="Opacity" Value="0.3"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                </Button>
                <Button Click="Print_Click" ToolTip="Print">
                    <Image Source="Icons/print3.png" Height="20" Width="20"/>
                </Button>
                <Separator />
                <Button x:Name="UndoButton" Click="Undo_Click" ToolTip="Undo">
                    <Image Source="Icons/undo3.png" Height="20" Width="20">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=Button}}" Value="False">
                                        <Setter Property="Opacity" Value="0.3"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                </Button>
                <Button x:Name="RedoButton" Click="Redo_Click" ToolTip="Redo">
                    <Image Source="Icons/redo3.png" Height="20" Width="20">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=Button}}" Value="False">
                                        <Setter Property="Opacity" Value="0.3"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                </Button>
                <Button Click="Copy_Click" ToolTip="Copy">
                    <Image Source="Icons/copy3.png" Height="20" Width="20"/>
                </Button>
                <Separator />
                <Button Click="PenWidth_Click" ToolTip="Pen Width">
                    <Image Source="Icons/width3.png" Height="20" Width="20"/>
                </Button>
                <Button Click="PenColor_Click" ToolTip="Pen Color">
                    <Image Source="Icons/color3.png" Height="20" Width="20"/>
                </Button>
            </ToolBar>
        </ToolBarTray>

        <Grid>
        <TabControl x:Name="tabControl" SelectionChanged="tabControl_SelectionChanged">
            <TabItem Header="Tab 1">
                <local:DrawingPage x:Name="dp"/>
            </TabItem>
        </TabControl>
    </Grid>
    </DockPanel>
</Window>
