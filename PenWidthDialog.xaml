<Window x:Class="Scribble.PenWidthDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Scribble"
        mc:Ignorable="d"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        Title="Pen Width"
        WindowStartupLocation="CenterOwner"
        Height="230" Width="225">
    <Grid>
        <StackPanel Margin="20">
            <TextBlock Text="Select Pen Width:" Margin="0,0,0,10"/>

            <Line X1="10" Y1="10" X2="150" Y2="10" 
          Stroke="Black" 
          StrokeThickness="{Binding ElementName=WidthSlider, Path=Value}"
          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
          Margin="0,0,0,20"/>

            <Slider Name="WidthSlider" Minimum="1" Maximum="10" Value="2" 
            TickFrequency="1" IsSnapToTickEnabled="True"/>

            <Button Content="OK" Click="OkButton_Click" Width="60" Margin="0,20,0,0"/>
            <Button Content="Cancel" Click="CancelButton_Click" Width="60" Margin="0,10,0,0"/>
        </StackPanel>

    </Grid>
</Window>
