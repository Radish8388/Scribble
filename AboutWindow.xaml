<Window x:Class="Scribble.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Scribble"
        mc:Ignorable="d"
        Title="About Scribble" 
        Height="350" Width="200"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    
    <StackPanel Margin="20">
        <Image Source="/Icons/scribble3.ico" Width="32" Height="32" Margin="10" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <TextBlock Text="Scribble" FontSize="18" FontWeight="Bold"/>
        <TextBlock Text="A simple drawing app, based on the classic MFC tutorial." Margin="0,10,0,0" TextWrapping="Wrap"/>
        <TextBlock Text="Version 1.3.1" Margin="0,10,0,0"/>
        <TextBlock Text="Created by Radish" Margin="0,5,0,0"/>
        <TextBlock Text="© 2026" Margin="0,5,0,0"/>

        <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,5,0,5">
        <Hyperlink NavigateUri="https://radish-vert.vercel.app" RequestNavigate="Hyperlink_RequestNavigate">
            radish-vert.vercel.app
        </Hyperlink>
        </TextBlock>

        <Button Content="OK" Width="75" Margin="0,20,0,0" Click="OK_Click" IsDefault="True"/>
    </StackPanel>

</Window>
